{
  "version": 1,
  "defaults": {
    "security": "deny",
    "ask": "on-miss",
    "askFallback": "deny",
    "autoAllowSkills": false
  },
  "agents": {
    "main": {
      "security": "allowlist",
      "ask": "off",
      "askFallback": "deny",
      "autoAllowSkills": false,
      "allowlist": [
        {
          "pattern": "smart-p1sc",
          "argPattern": "^--json (status|health|snapshot)$"
        },
        {
          "pattern": "smart-p1sc",
          "argPattern": "^--json incidents( --open)?( --limit [0-9]{1,3})?$"
        },
        {
          "pattern": "smart-p1sc",
          "argPattern": "^--json incident show [A-Za-z0-9-]{1,40}$"
        },
        {
          "pattern": "smart-p1sc",
          "argPattern": "^--json incident decide [A-Za-z0-9-]{1,40} --action (resume|stop|false_positive) --code [A-Za-z0-9]{4}$"
        },
        {
          "pattern": "smart-p1sc",
          "argPattern": "^--json incident label [A-Za-z0-9-]{1,40} --label (true_positive|false_positive|unknown)$"
        }
      ]
    }
  }
}
